BUILD=build
ISO_ROOT=$(BUILD)/iso_root

ASM=nasm
CC=gcc

CFLAGS=-m32 -ffreestanding -Wall -Wextra -Werror -fno-pie -fno-asynchronous-unwind-tables -nostdlib -MMD -MP $(EXTRA_CFLAGS)

HOST_CC=gcc
HOST_CFLAGS=-std=c11 -Wall -Wextra -Werror -g -I. -fsanitize=address,undefined -MMD -MP

.PHONY: all clean iso run test test-host test-qemu

# Only search directories that exist (e.g. hal/ is picked up once created).
SRC_DIRS := $(wildcard boot hal kernel arch emu)

C_SOURCES := $(shell find $(SRC_DIRS) -name "*.c")
ASM_SOURCES := $(shell find $(SRC_DIRS) -name "*.asm")

C_OBJECTS := $(C_SOURCES:%.c=$(BUILD)/%.o)
ASM_OBJECTS := $(ASM_SOURCES:%.asm=$(BUILD)/%.o)

OBJECTS := $(C_OBJECTS) $(ASM_OBJECTS)

$(info C sources: $(C_SOURCES))
$(info ASM sources: $(ASM_SOURCES))

$(BUILD)/%.o: %.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%.o: %.asm
	mkdir -p $(dir $@)
	$(ASM) -f elf32 $< -o $@

$(BUILD)/kernel.elf: $(OBJECTS)
	ld -m elf_i386 -T linker.ld \
		$(OBJECTS) \
		-o $@

# Header dependencies generated by -MMD.
-include $(C_OBJECTS:.o=.d)

clean:
	rm -rf $(BUILD)

iso: $(BUILD)/kernel.elf
	rm -rf $(ISO_ROOT)
	mkdir -p $(ISO_ROOT)/boot/grub
	cp $(BUILD)/kernel.elf $(ISO_ROOT)/boot/
	cp grub.cfg $(ISO_ROOT)/boot/grub/
	grub-mkrescue -o $(BUILD)/68k_HAL.iso $(ISO_ROOT)

run: iso
	qemu-system-i386 -cdrom $(BUILD)/68k_HAL.iso -serial stdio

all: $(BUILD)/kernel.elf

# ---------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------

# Hardware-independent sources that can be built and tested on the host.
HOST_LIB_SOURCES := \
	kernel/interrupt/page_fault.c \
	kernel/lib/k_string.c \
	kernel/lib/k_number.c \
	kernel/lib/k_memory.c \
	kernel/lib/ring_buffer.c \
	kernel/memory/heap.c \
	kernel/memory/multiboot.c \
	kernel/memory/paging_entry.c \
	kernel/memory/pmm.c \
	kernel/shell/parser.c \
	$(wildcard emu/m68k/*.c)

HOST_LIB_OBJECTS := $(HOST_LIB_SOURCES:%.c=$(BUILD)/host/obj/%.o)

HOST_TESTS := $(patsubst tests/host/%.c,$(BUILD)/host/%,$(wildcard tests/host/test_*.c))
HOST_TEST_OBJECTS := $(HOST_TESTS:$(BUILD)/host/%=$(BUILD)/host/obj/tests/host/%.o)

# Keep test objects so make does not delete them as intermediates.
.SECONDARY: $(HOST_TEST_OBJECTS)

# Each source is compiled separately so -MMD can emit one .d file per object.
$(BUILD)/host/obj/%.o: %.c
	mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_CFLAGS) -c $< -o $@

$(BUILD)/host/%: $(BUILD)/host/obj/tests/host/%.o $(HOST_LIB_OBJECTS)
	mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_CFLAGS) $^ -o $@

-include $(HOST_LIB_OBJECTS:.o=.d) $(HOST_TEST_OBJECTS:.o=.d)

test-host: $(HOST_TESTS)
	@for t in $(HOST_TESTS); do ./$$t || exit 1; done

# Kernel built with -DKERNEL_SELFTEST, booted directly by QEMU (no ISO).
# QEMU exits with 33 on PASS (see kernel/test/selftest.c).
QEMU_TEST_FLAGS := -display none -serial stdio -no-reboot \
	-device isa-debug-exit,iobase=0xf4,iosize=0x04

test-qemu:
	$(MAKE) --no-print-directory BUILD=$(BUILD)/test \
		EXTRA_CFLAGS=-DKERNEL_SELFTEST $(BUILD)/test/kernel.elf
	@timeout 10 qemu-system-i386 -kernel $(BUILD)/test/kernel.elf $(QEMU_TEST_FLAGS); \
	status=$$?; \
	if [ $$status -eq 33 ]; then \
		echo "QEMU selftest: PASS"; \
	else \
		echo "QEMU selftest: FAIL (exit status $$status)"; \
		exit 1; \
	fi

test: test-host test-qemu
